# CircuitDesk Environment Template (Placeholders Only - Never Commit Real Secrets)

NODE_ENV=development
APP_URL=http://localhost:3000
DEMO_MODE=true

# PostgreSQL (Managed Neon / Postgres 17). Leave blank locally to run embedded PGLite.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Required cryptographic secrets (>= 32 chars in production; ENCRYPTION_KEY = 64 hex chars for AES-256-GCM)
AUTH_SECRET=replace-with-32-byte-random-auth-secret-in-production
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FILE_SIGNING_SECRET=replace-with-32-byte-random-file-signing-secret-prod
WEBHOOK_SIGNING_SECRET=replace-with-32-byte-random-webhook-signing-secret-prod

# Billing providers (optional; when unset, Billing runs in labelled Non-Charging Demo Mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_USD=
STRIPE_PRICE_GROWTH_USD=
STRIPE_PRICE_SCALE_USD=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_INR=
RAZORPAY_PLAN_GROWTH_INR=
RAZORPAY_PLAN_SCALE_INR=

# Official Commerce Connectors (optional)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=

# Notifications (optional; when unset, messages record in the tenant dev sink)
RESEND_API_KEY=
EMAIL_FROM="CircuitDesk Ops <ops@circuitdesk.example>"
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional AI Triage Assistant (server-side key; deterministic evidence extractor runs when unset)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
